# ============================================
# OTH - One Time Handshake Environment Config
# ============================================
# Copy this file to .env and fill in all values
# NEVER commit .env to version control

# --- App ---
NODE_ENV=development
APP_NAME="One Time Handshake"
APP_VERSION=1.0.0

# --- Backend Server ---
BACKEND_PORT=3001
BACKEND_HOST=0.0.0.0
BACKEND_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3000,http://localhost:19006

# --- Web Admin ---
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_NAME="OTH Admin"
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# --- Database ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=oth_db
MYSQL_USER=oth_user
MYSQL_PASSWORD=your_strong_mysql_password
MYSQL_ROOT_PASSWORD=your_root_password
MYSQL_CONNECTION_LIMIT=20

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
REDIS_DB=0
REDIS_TTL=3600

# --- JWT ---
JWT_SECRET=your_256_bit_jwt_secret_key_here_minimum_32_chars
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=your_256_bit_refresh_secret_key_here
JWT_REFRESH_EXPIRES_IN=7d

# --- OTH Encryption ---
OTH_MASTER_KEY=your_32_byte_aes_master_key_hex_64_chars
OTH_NONCE_TTL_SECONDS=60
OTH_HANDSHAKE_EXPIRY_SECONDS=30
OTH_MAX_CLOCK_DRIFT_SECONDS=30
OTH_MAX_FAILED_ATTEMPTS=5
OTH_LOCKOUT_DURATION_MINUTES=15

# --- Firebase Admin SDK ---
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_PRIVATE_KEY_ID=your_private_key_id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your_project.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=your_client_id
FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token

# --- Security ---
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
API_KEY_LENGTH=64
DEVICE_SALT_ROTATION_DAYS=90

# --- Admin ---
ADMIN_EMAIL=admin@oth.gov.in
ADMIN_PASSWORD=your_strong_admin_password
ADMIN_SECRET_KEY=your_admin_secret_key

# --- Notifications ---
FCM_SERVER_KEY=your_fcm_server_key

# --- Organization ---
DEFAULT_ORG_NAME="OTH Platform"
DEFAULT_ORG_PLAN=enterprise
