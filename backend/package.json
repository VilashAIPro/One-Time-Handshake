{
  "name": "@oth/backend",
  "version": "1.0.0",
  "description": "OTH Backend API Server",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/index.ts",
    "build": "tsc && tsc-alias",
    "start": "node dist/index.js",
    "test": "jest --coverage --forceExit",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .ts",
    "migrate": "ts-node src/db/migrate.ts"
  },
  "dependencies": {
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "express-validator": "^7.1.0",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "compression": "^1.7.4",
    "mysql2": "^3.10.0",
    "redis": "^4.6.14",
    "jsonwebtoken": "^9.0.2",
    "bcrypt": "^5.1.1",
    "qrcode": "^1.5.3",
    "uuid": "^9.0.1",
    "dotenv": "^16.4.5",
    "firebase-admin": "^12.3.0",
    "winston": "^3.13.0",
    "swagger-ui-express": "^5.0.1",
    "yamljs": "^0.3.0",
    "ws": "^8.17.1",
    "express-async-errors": "^3.1.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/morgan": "^1.9.9",
    "@types/compression": "^1.7.5",
    "@types/bcrypt": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/qrcode": "^1.5.5",
    "@types/uuid": "^9.0.8",
    "@types/ws": "^8.5.10",
    "@types/yamljs": "^0.2.34",
    "@types/jest": "^29.5.12",
    "@types/supertest": "^6.0.2",
    "@types/node": "^20.14.2",
    "typescript": "^5.4.5",
    "ts-node": "^10.9.2",
    "nodemon": "^3.1.4",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.4",
    "supertest": "^7.0.0",
    "tsc-alias": "^1.8.10"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "testMatch": ["**/*.test.ts"],
    "setupFilesAfterFramework": ["./src/test/setup.ts"]
  }
}
